{
  "name": "yanote",
  "private": true,
  "version": "1.1.0",
  "description": "yanote: editor de notas Markdown flotante con pestañas, terminal y chat con Claude Code",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "electron .",
    "lint": "oxlint",
    "preview": "vite preview",
    "package:portable": "npm run build && electron-builder --win portable --publish never",
    "package:dir": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis portable --publish never",
    "release": "npm run build && electron-builder --win nsis portable --publish always"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@mdxeditor/editor": "^4.5.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.7.1",
    "jsdom": "^31.0.0",
    "lucide-react": "^1.16.0",
    "oxlint": "^1.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.4",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.yanote.app",
    "productName": "yanote",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**",
      "node_modules/@anthropic-ai/claude-agent-sdk/**",
      "node_modules/@anthropic-ai/claude-agent-sdk-win32-x64/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "yanote-Portable-${version}.exe"
    },
    "nsis": {
      "artifactName": "yanote-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "yanote",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "aalfaray",
        "repo": "yanote",
        "releaseType": "release"
      }
    ]
  },
  "author": "aalfaray",
  "homepage": "https://aalfaray.github.io/yanote/",
  "repository": {
    "type": "git",
    "url": "https://github.com/aalfaray/yanote.git"
  }
}
